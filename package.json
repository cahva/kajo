{
  "name": "@cahva/kajo",
  "version": "0.1.3",
  "description": "Typed in-memory API mocking for browsers and Node.js. Define routes, models, relationships, factories, and serializers in TypeScript, or serve them from an OpenAPI 3.1 document. Intercepts fetch and XMLHttpRequest. Inspired by Mirage JS.",
  "homepage": "https://github.com/cahva/kajo#readme",
  "bugs": {
    "url": "https://github.com/cahva/kajo/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cahva/kajo.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./openapi/ajv": "./dist/openapi/ajv.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "example:petstore": "cd examples/petstore && vp run dev",
    "example:task-board": "cd examples/task-board && vp dev",
    "publish:check": "vp exec jsr publish --dry-run --allow-dirty",
    "test": "vp test",
    "test:browser": "vp test --config vite.browser.config.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.42.3",
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@readme/oas-examples": "^8.2.2",
    "@types/node": "^26.1.1",
    "@valibot/to-json-schema": "^1.7.1",
    "@vitest/browser-playwright": "4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "arktype": "^2.2.3",
    "jsr": "0.14.3",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "valibot": "^1.4.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    },
    "ajv-formats": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
